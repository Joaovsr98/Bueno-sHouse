{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/swagger-ui.html", "destination": "/swagger-ui/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bueno-s-house-api.onrender.com/api/:path*" },
    { "source": "/swagger-ui/:path*", "destination": "https://bueno-s-house-api.onrender.com/swagger-ui/:path*" },
    { "source": "/v3/api-docs/:path*", "destination": "https://bueno-s-house-api.onrender.com/v3/api-docs/:path*" },
    { "source": "/v3/api-docs", "destination": "https://bueno-s-house-api.onrender.com/v3/api-docs" },
    { "source": "/((?!api/|ws|swagger-ui|v3/api-docs).*)", "destination": "/index.html" }
  ]
}
