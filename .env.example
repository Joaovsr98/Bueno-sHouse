# Copie este arquivo para ".env" e preencha com valores reais antes de rodar
# "docker compose up -d". NUNCA cometa o arquivo ".env" real em nenhum
# repositorio - apenas este .env.example, sem senhas reais.

# --- Banco de dados MySQL ---
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
DB_NAME=restaurante_db
DB_USER=restaurante_app
DB_PASSWORD=troque_esta_senha_app
DB_PORT=3306

# --- Backend ---
SERVER_PORT=8080
# dev = inclui seed de demonstracao (db/seed). prod = so migrations obrigatorias.
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=troque_este_segredo_por_uma_string_longa_e_aleatoria_de_producao
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend (Angular + nginx) ---
ANGULAR_PORT=4200

# --- Producao (docker-compose.prod.yml) -- ver docs/DEPLOY.md ---
# DOMAIN=comanda.seudominio.com.br
# SPRING_PROFILES_ACTIVE=prod
# Cria o PRIMEIRO administrador (+ restaurante/unidade) se o banco nao tiver nenhum.
# Depois do primeiro boot, remova estas linhas.
# BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com.br
# BOOTSTRAP_ADMIN_PASSWORD=uma_senha_forte_com_8_ou_mais_caracteres
# BOOTSTRAP_RESTAURANT_NAME=Nome do Restaurante
